    },
    {
      "source": "/supabase-orders.sql",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/PRODUCT-PAGE-README.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ORDERS-README.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/INSTALL-PHONE-FIX.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ADD-ON-UPGRADE-README.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/BILL-README.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/INSTALL.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/LOOK-README.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/INSTALL-APP-POPUP.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ADD-ON-INSTALL.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/CATALOG-README.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/android-app/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/final-package/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.github/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path*.keystore",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tools/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin-dashboard.html",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/admin-orders.html",
      "destination": "/admin/orders",
      "permanent": false
    },
    {
      "source": "/admin-products.html",
      "destination": "/admin/products",
      "permanent": false
    },
    {
      "source": "/admin-payments.html",
      "destination": "/admin/payments",
      "permanent": false
    },
    {
      "source": "/admin-sellers.html",
      "destination": "/admin/sellers",
      "permanent": false
    },
    {
      "source": "/admin-seller-applications.html",
      "destination": "/admin/sellers",
      "permanent": false
    },
    {
      "source": "/server/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/scripts/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tests/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package-lock.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/node_modules/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path*.sql",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/DEPLOY-ADMIN-PORTAL.md",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin/page?p="
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/admin/page?p=:path*"
    },
    {
      "source": "/product/:slug",
      "destination": "/product.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{js/products-data.js,js/toys-defaults.js,server/admin-ui/**}",
      "maxDuration": 30
    }
  }
}